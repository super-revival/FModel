@@ -0,0 +1,40 @@
+using CUE4Parse.UE4.Assets.Readers;
+
+namespace CUE4Parse.UE4.Assets.Exports.CustomizableObject.Mutable.Legacy;
+
+/** Description entry serialised with the pre-Epic mu::PROGRAM but never read by the runtime (member names are descriptive). */
+public class FMutableLegacyDescEntry
+{
+    public int Type;
+    public string Name;
+    public string UID;
+    public int Value0;
+    public int Value1;
+    public FMutableLegacyNamedIndex[] List0;
+    public FMutableLegacyNamedIndex[] List1;
+    public FMutableLegacyNamedIndex[] List2;
+
+    public FMutableLegacyDescEntry(FMutableArchive Ar)
+    {
+        Type = Ar.Read<int>();
+        Name = Ar.ReadString();
+        UID = Ar.ReadString();
+        Value0 = Ar.Read<int>();
+        Value1 = Ar.Read<int>();
+        List0 = Ar.ReadArray(() => new FMutableLegacyNamedIndex(Ar));
+        List1 = Ar.ReadArray(() => new FMutableLegacyNamedIndex(Ar));
+        List2 = Ar.ReadArray(() => new FMutableLegacyNamedIndex(Ar));
+    }
+}
+
+public class FMutableLegacyNamedIndex
+{
+    public int Index;
+    public string Name;
+
+    public FMutableLegacyNamedIndex(FMutableArchive Ar)
+    {
+        Index = Ar.Read<int>();
+        Name = Ar.ReadString();
+    }
+}
