+using CUE4Parse.UE4.Assets.Readers;
+
+namespace CUE4Parse.UE4.Assets.Exports.CustomizableObject.Mutable.Legacy;
+
+/** mu::PROGRAM::ROM: block of constant resources streamed from MutableStreamedData/<Location>-k0-k1-k2-k3.mut. */
+public class FMutableLegacyRom
+{
+    public string Id;
+    /** Size of the streamed file in bytes. */
+    public ulong Size;
+    /** Streamed file name inside MutableStreamedData (null when the model location is unknown). */
+    public string? FileName;
+
+    public FMutableLegacyRom(FMutableArchive Ar, string? location)
+    {
+        var key0 = Ar.Read<uint>();
+        var key1 = Ar.Read<uint>();
+        var key2 = Ar.Read<uint>();
+        var key3 = Ar.Read<uint>();
+        Size = Ar.Read<ulong>();
+        Id = $"{key0:x8}-{key1:x8}-{key2:x8}-{key3:x8}";
+        if (location != null)
+            FileName = $"{location.Replace('/', '_')}-{Id}.mut";
+    }
+}
