@@ -0,0 +1,55 @@
+using CUE4Parse.UE4.Assets.Exports.CustomizableObject.Mutable.Mesh.Layout;
+using CUE4Parse.UE4.Assets.Readers;
+using CUE4Parse.UE4.Objects.Core.Math;
+using Newtonsoft.Json;
+
+namespace CUE4Parse.UE4.Assets.Exports.CustomizableObject.Mutable.Legacy;
+
+/** mu::Layout (versions 0-2) of the pre-Epic Mutable runtime. */
+public class FMutableLegacyLayout
+{
+    [JsonIgnore] public int Version;
+    public FIntVector2 Size;
+    public FIntVector2 MaxSize;
+    public EPackStrategy Strategy;
+    public FMutableLegacyLayoutBlock[] Blocks;
+
+    public FMutableLegacyLayout(FMutableArchive Ar)
+    {
+        Version = Ar.Read<int>();
+        var size = Ar.Read<TIntVector2<ushort>>();
+        Size = new FIntVector2(size.X, size.Y);
+        Blocks = Ar.ReadArray(() => new FMutableLegacyLayoutBlock(Ar, Version));
+        if (Version >= 2)
+        {
+            var maxSize = Ar.Read<TIntVector2<ushort>>();
+            MaxSize = new FIntVector2(maxSize.X, maxSize.Y);
+            Strategy = (EPackStrategy) Ar.Read<int>();
+        }
+    }
+}
+
+public class FMutableLegacyLayoutBlock
+{
+    public FIntVector2 Min;
+    public FIntVector2 Size;
+    /** Absolute id used to match the blocks of different layouts. */
+    public int Id;
+    /** Serialised since the first version but not read by the runtime. */
+    public int Reserved;
+    public int Priority;
+
+    public FMutableLegacyLayoutBlock(FMutableArchive Ar, int version)
+    {
+        var min = Ar.Read<TIntVector2<ushort>>();
+        Min = new FIntVector2(min.X, min.Y);
+        var size = Ar.Read<TIntVector2<ushort>>();
+        Size = new FIntVector2(size.X, size.Y);
+        Id = Ar.Read<int>();
+        Reserved = Ar.Read<int>();
+        if (version >= 2)
+            Priority = Ar.Read<int>();
+        else if (version == 0)
+            Ar.Position += 1; // unused byte
+    }
+}
