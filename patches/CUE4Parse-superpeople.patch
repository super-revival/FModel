@@ -8,13 +11,29 @@ namespace CUE4Parse.UE4.Assets.Exports.CustomizableObject;
 
 public class UCustomizableObject : UObject
 {
+    /** Pre-Epic Mutable: models are saved with this embedded data version. */
+    private const int LegacyEmbeddedDataVersion = 261;
+    /** Pre-Epic Mutable: a bHasModel flag follows InternalVersion after this version. */
+    private const int LegacyHasModelFlagVersion = 90;
+
     public long InternalVersion;
     public FModel? Model;
 
+    public bool? bHasModel;
+    public int? EmbeddedDataVersion;
+    /** Model of the pre-Epic (Anticto 1.x, UE4) Mutable runtime. */
+    public FMutableLegacyModel? LegacyModel;
+
     public override void Deserialize(FAssetArchive Ar, long validPos)
     {
         base.Deserialize(Ar, validPos);
 
+        if (Ar.Game is GAME_SuperPeople)
+        {
+            DeserializeLegacy(Ar, validPos);
+            return;
+        }
+
         InternalVersion = Ar.Game >= GAME_UE5_6 ? Ar.Read<long>() : Ar.Read<int>();
         if (InternalVersion != -1)
             Model = new FModel(new FMutableArchive(Ar));
@@ -25,12 +44,72 @@ public override void Deserialize(FAssetArchive Ar, long validPos)
         }
     }
 
+    private void DeserializeLegacy(FAssetArchive Ar, long validPos)
+    {
+        try
+        {
+            InternalVersion = Ar.Read<int>();
+            bHasModel = InternalVersion <= LegacyHasModelFlagVersion || Ar.Read<int>() != 0;
+            if (bHasModel != true) return;
+
+            EmbeddedDataVersion = Ar.Read<int>();
+            if (EmbeddedDataVersion != LegacyEmbeddedDataVersion)
+            {
+                Log.Warning("CustomizableObject {Name}: unsupported Mutable embedded data version {Version}, skipping model", Name, EmbeddedDataVersion);
+                Ar.Position = validPos;
+                return;
+            }
+
+            LegacyModel = new FMutableLegacyModel(new FMutableArchive(Ar), GetLegacyModelLocation());
+        }
+        catch (Exception e)
+        {
+            Log.Error(e, "CustomizableObject {Name}: failed to read legacy Mutable model, skipping it", Name);
+            LegacyModel = null;
+            Ar.Position = validPos;
+        }
+    }
+
+    /** UCustomizableObject::GetFileName of pre-Epic Mutable: Name + "_" + MD5(path name), the prefix of the streamed .mut files. */
+    private string? GetLegacyModelLocation()
+    {
+        var packageName = Owner?.Name;
+        if (string.IsNullOrEmpty(packageName)) return null;
+
+        // Mounted package names look like "<Project>/Content/Path/Asset", the hashed path name is "/Game/Path/Asset.Asset".
+        if (!packageName.StartsWith('/'))
+        {
+            var contentIndex = packageName.IndexOf("/Content/", StringComparison.OrdinalIgnoreCase);
+            if (contentIndex < 0) return null;
+            packageName = "/Game/" + packageName[(contentIndex + "/Content/".Length)..];
+        }
+
+        var hash = MD5.HashData(Encoding.UTF8.GetBytes($"{packageName}.{Name}"));
+        return $"{Name}_{Convert.ToHexString(hash).ToLowerInvariant()}";
+    }
+
     protected internal override void WriteJson(JsonWriter writer, JsonSerializer serializer)
     {
         base.WriteJson(writer, serializer);
         writer.WritePropertyName(nameof(InternalVersion));
         writer.WriteValue(InternalVersion);
+
+        if (bHasModel != null)
+        {
+            writer.WritePropertyName(nameof(bHasModel));
+            writer.WriteValue(bHasModel.Value);
+        }
+
+        if (EmbeddedDataVersion != null)
+        {
+            writer.WritePropertyName(nameof(EmbeddedDataVersion));
+            writer.WriteValue(EmbeddedDataVersion.Value);
+        }
+
         writer.WritePropertyName(nameof(Model));
-        serializer.Serialize(writer, Model);
+        if (LegacyModel != null)
+            serializer.Serialize(writer, LegacyModel);
+        else
+            serializer.Serialize(writer, Model);
     }
 }
