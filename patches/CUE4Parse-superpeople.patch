+using CUE4Parse.UE4.Assets.Readers;
+using Newtonsoft.Json;
+
+namespace CUE4Parse.UE4.Assets.Exports.CustomizableObject.Mutable.Legacy;
+
+/**
+ * mu::Model of the pre-Epic Mutable runtime (Anticto Mutable 1.x for UE4, embedded data version 261).
+ * Layout: int32 version (0), then mu::PROGRAM.
+ */
+public class FMutableLegacyModel
+{
+    [JsonIgnore] public int Version;
+    /** Name used to locate the streamed rom files: "<ObjectName>_<md5(object path)>". */
+    public string? Location;
+    public FMutableLegacyProgram Program;
+
+    public FMutableLegacyModel(FMutableArchive Ar, string? location)
+    {
+        Location = location;
+        Version = Ar.Read<int>();
+        Program = new FMutableLegacyProgram(Ar, location);
+    }
+}
diff --git a/CUE4Parse/UE4/Assets/Exports/CustomizableObject/Mutable/Legacy/FMutableLegacyParameterDesc.cs b/CUE4Parse/UE4/Assets/Exports/CustomizableObject/Mutable/Legacy/FMutableLegacyParameterDesc.cs
