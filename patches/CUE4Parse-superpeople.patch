@@ -0,0 +1,85 @@
+using System.Runtime.InteropServices;
+using CUE4Parse.UE4.Assets.Exports.CustomizableObject.Mutable.Parameters;
+using CUE4Parse.UE4.Assets.Readers;
+using CUE4Parse.UE4.Exceptions;
+using Newtonsoft.Json;
+
+namespace CUE4Parse.UE4.Assets.Exports.CustomizableObject.Mutable.Legacy;
+
+/** mu::PARAMETER_DESC (versions 0-3) of the pre-Epic Mutable runtime. */
+public class FMutableLegacyParameterDesc
+{
+    /** Size of the serialised mu::PARAMETER_VALUE union. */
+    private const int ParameterValueSize = 56;
+
+    [JsonIgnore] public int Version;
+    public string Name;
+    public string UID = string.Empty;
+    public EParameterType Type;
+    /** bool, int, float, float[3] colour, FProjector, or ulong external image id, depending on Type. */
+    public object? DefaultValue;
+    /** Ranges, if the parameter is multi-dimensional. Indices into the program range descriptors. */
+    public uint[] Ranges = [];
+    /** Constant images describing the parameter (thumbnails). */
+    public uint[] DescImages;
+    /** For integer parameters, the description of the possible values. */
+    public FIntValueDesc[] PossibleValues;
+
+    public FMutableLegacyParameterDesc(FMutableArchive Ar)
+    {
+        Version = Ar.Read<int>();
+        Name = Ar.ReadString();
+        if (Version >= 2)
+            UID = Ar.ReadString();
+
+        var type = Ar.Read<int>();
+        Type = type switch
+        {
+            >= 0 and <= 5 => (EParameterType) type, // none, bool, int, float, colour, projector
+            6 => EParameterType.Image,
+            _ => throw new ParserException(Ar, $"Unknown Mutable parameter type {type}")
+        };
+
+        var value = Ar.ReadBytes(ParameterValueSize);
+        DefaultValue = Type switch
+        {
+            EParameterType.Bool => value[0] != 0,
+            EParameterType.Int => BitConverter.ToInt32(value, 0),
+            EParameterType.Float => BitConverter.ToSingle(value, 0),
+            EParameterType.Color => new[] { BitConverter.ToSingle(value, 0), BitConverter.ToSingle(value, 4), BitConverter.ToSingle(value, 8) },
+            EParameterType.Projector => MemoryMarshal.Read<FProjector>(value),
+            EParameterType.Image => BitConverter.ToUInt64(value, 0),
+            _ => null
+        };
+
+        if (Version >= 3)
+            Ranges = Ar.ReadArray<uint>();
+
+        DescImages = Ar.ReadArray<uint>();
+
+        if (Version >= 1)
+        {
+            PossibleValues = Ar.ReadArray(() => new FIntValueDesc(Ar));
+        }
+        else
+        {
+            PossibleValues = Ar.ReadArray<short>().Select(v => new FIntValueDesc(v)).ToArray();
+        }
+    }
+}
+
+/** mu::RANGE_DESC (versions 0-1) of the pre-Epic Mutable runtime. */
+public class FMutableLegacyRangeDesc
+{
+    [JsonIgnore] public int Version;
+    public string Name;
+    public string UID = string.Empty;
+
+    public FMutableLegacyRangeDesc(FMutableArchive Ar)
+    {
+        Version = Ar.Read<int>();
+        Name = Ar.ReadString();
+        if (Version >= 1)
+            UID = Ar.ReadString();
+    }
+}
diff --git a/CUE4Parse/UE4/Assets/Exports/CustomizableObject/Mutable/Legacy/FMutableLegacyProgram.cs b/CUE4Parse/UE4/Assets/Exports/CustomizableObject/Mutable/Legacy/FMutableLegacyProgram.cs
new file mode 100644
index 0000000000000000000000000000000000000000..84aa90d03c93aa88399a7b93853346ef763b33eb
--- /dev/null
+++ b/CUE4Parse/UE4/Assets/Exports/CustomizableObject/Mutable/Legacy/FMutableLegacyProgram.cs
@@ -0,0 +1,125 @@
+using CUE4Parse.UE4.Assets.Exports.CustomizableObject.Mutable.Parameters;
+using CUE4Parse.UE4.Assets.Readers;
+using CUE4Parse.UE4.Exceptions;
+using CUE4Parse.UE4.Objects.Core.Math;
+using CUE4Parse.UE4.Objects.Engine.Curves;
+using Newtonsoft.Json;
+
+namespace CUE4Parse.UE4.Assets.Exports.CustomizableObject.Mutable.Legacy;
+
+/**
+ * mu::PROGRAM of the pre-Epic Mutable runtime. Large members (byte code, constant mesh locations, switch case lists,
+ * clip shapes) are kept in memory but only summarised in json.
+ */
+public class FMutableLegacyProgram
+{
+    /** Location in ByteCode of the beginning of each operation. */
+    [JsonIgnore] public uint[] OpAddress;
+    /** Byte-coded operations: uint16 EMutableLegacyOpType followed by the op arguments. */
+    [JsonIgnore] public byte[] ByteCode;
+    public int OpCount;
+    public int ByteCodeSize;
+    /** Number of operations of each type in the byte code. */
+    public Dictionary<string, int> OpTypeCounts;
+
+    public FState[] States;
+    /** Streamed data blocks (MutableStreamedData/*.mut). */
+    public FMutableLegacyRom[] Roms;
+
+    /** Location of every constant resource: rom index and index inside the rom. */
+    [JsonIgnore] public FMutableLegacyConstantResource[] ConstantImages;
+    [JsonIgnore] public FMutableLegacyConstantResource[] ConstantVolumes;
+    [JsonIgnore] public FMutableLegacyConstantResource[] ConstantMeshes;
+    public int ConstantImageCount;
+    public int ConstantVolumeCount;
+    public int ConstantMeshCount;
+
+    public string[] ConstantStrings;
+    public FMutableLegacyLayout?[] ConstantLayouts;
+    public FProjector[] ConstantProjectors;
+    public FMatrix[] ConstantMatrices;
+    [JsonIgnore] public FShape[] ConstantShapes;
+    public int ConstantShapeCount;
+    public Dictionary<string, int> ConstantShapeTypeCounts;
+    public FRichCurve[] ConstantCurves;
+    /** Switch cases ({int32 condition, uint32 address} packed in a uint64), one list per switch op. */
+    [JsonIgnore] public ulong[][] ConstantLists;
+    public int ConstantListCount;
+    public int ConstantListEntryCount;
+    public FMutableLegacySkeleton?[] ConstantSkeletons;
+    public FMutableLegacyDescEntry[] DescEntries;
+
+    /** Parameters of the model. The value stored here is the default value. */
+    public FMutableLegacyParameterDesc[] Parameters;
+    public FMutableLegacyRangeDesc[] Ranges;
+    public ushort[][] ParameterLists;
+
+    public FMutableLegacyProgram(FMutableArchive Ar, string? location)
+    {
+        OpAddress = Ar.ReadArray<uint>();
+        ByteCode = Ar.ReadArray<byte>();
+        OpCount = OpAddress.Length;
+        ByteCodeSize = ByteCode.Length;
+        OpTypeCounts = CountOpTypes();
+
+        States = Ar.ReadArray(() => new FState(Ar));
+
+        // Loaded rom blocks: always null in cooked data (UnloadExternal runs before saving).
+        var romData = Ar.ReadPtrArray<object>(() => throw new ParserException(Ar, "Embedded Mutable RomData is not supported"));
+        if (romData.Any(r => r != null))
+            throw new ParserException(Ar, "Embedded Mutable RomData is not supported");
+
+        Roms = Ar.ReadArray(() => new FMutableLegacyRom(Ar, location));
+
+        ConstantImages = Ar.ReadArray<FMutableLegacyConstantResource>();
+        ConstantVolumes = Ar.ReadArray<FMutableLegacyConstantResource>();
+        ConstantMeshes = Ar.ReadArray<FMutableLegacyConstantResource>();
+        ConstantImageCount = ConstantImages.Length;
+        ConstantVolumeCount = ConstantVolumes.Length;
+        ConstantMeshCount = ConstantMeshes.Length;
+
+        ConstantStrings = Ar.ReadArray(Ar.ReadString);
+        ConstantLayouts = Ar.ReadPtrArray(() => new FMutableLegacyLayout(Ar));
+        ConstantProjectors = Ar.ReadArray<FProjector>();
+        ConstantMatrices = Ar.ReadArray(() => new FMatrix(Ar, false));
+        ConstantShapes = Ar.ReadArray<FShape>();
+        ConstantShapeCount = ConstantShapes.Length;
+        ConstantShapeTypeCounts = ConstantShapes.GroupBy(s => s.Type).OrderBy(g => g.Key).ToDictionary(g => g.Key.ToString(), g => g.Count());
+        ConstantCurves = Ar.ReadArray(() => new FRichCurve { Keys = Ar.ReadArray(() => new FRichCurveKey(Ar)), DefaultValue = Ar.Read<float>() });
+        ConstantLists = Ar.ReadArray(Ar.ReadArray<ulong>);
+        ConstantListCount = ConstantLists.Length;
+        ConstantListEntryCount = ConstantLists.Sum(l => l.Length);
+        ConstantSkeletons = Ar.ReadPtrArray(() => new FMutableLegacySkeleton(Ar));
+        DescEntries = Ar.ReadArray(() => new FMutableLegacyDescEntry(Ar));
+
+        Parameters = Ar.ReadArray(() => new FMutableLegacyParameterDesc(Ar));
+        Ranges = Ar.ReadArray(() => new FMutableLegacyRangeDesc(Ar));
+        ParameterLists = Ar.ReadArray(Ar.ReadArray<ushort>);
+    }
+
+    public EMutableLegacyOpType GetOpType(uint at)
+    {
+        if (at >= OpAddress.Length || OpAddress[at] + 2 > ByteCode.Length) return EMutableLegacyOpType.NONE;
+        return (EMutableLegacyOpType) BitConverter.ToUInt16(ByteCode, (int) OpAddress[at]);
+    }
+
+    private Dictionary<string, int> CountOpTypes()
+    {
+        var counts = new SortedDictionary<ushort, int>();
+        for (uint at = 0; at < OpAddress.Length; at++)
+        {
+            var type = (ushort) GetOpType(at);
+            counts[type] = counts.TryGetValue(type, out var count) ? count + 1 : 1;
+        }
+
+        return counts.ToDictionary(
+            kv => Enum.IsDefined(typeof(EMutableLegacyOpType), kv.Key) ? ((EMutableLegacyOpType) kv.Key).ToString() : $"Unknown_{kv.Key}",
+            kv => kv.Value);
+    }
+}
+
+public struct FMutableLegacyConstantResource
+{
+    public uint Rom;
+    public uint Index;
+}
