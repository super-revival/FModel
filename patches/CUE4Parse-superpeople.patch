@@ -0,0 +1,65 @@
+using CUE4Parse.Encryption.Aes;
+using CUE4Parse.FileProvider;
+using CUE4Parse.GameTypes.SuperPeople.Encryption.Aes;
+using CUE4Parse.UE4.Versions;
+using CUE4Parse.UE4.Pak;
+using CUE4Parse.UE4.Readers;
+
+namespace CUE4Parse.Tests.Encryption;
+
+public class SuperPeopleAesTests
+{
+    private static readonly FAesKey Key = new(Enumerable.Range(0, 32).Select(i => (byte)i).ToArray());
+    private static readonly byte[] Ciphertext = Convert.FromHexString("25967be1e97962e03b2f75d84fb03a5d5b05fdb1a09f3a7d7e0d43a49e38c0b24c956b9801d3de8b91a55862bfab4f25b289e59f96d357493c659e061bf15b4d");
+
+    [Fact]
+    public void DecryptsKnownVectorWithoutChangingInput()
+    {
+        var input = Ciphertext.ToArray();
+        var actual = SuperPeopleAes.Decrypt(input, 0, input.Length, Key);
+        Assert.Equal(Enumerable.Range(0, 64).Select(i => (byte)i).ToArray(), actual);
+        Assert.Equal(Ciphertext, input);
+    }
+
+    [Fact]
+    public void SupportsSubrangeInPaddedBuffer()
+    {
+        var input = new byte[71];
+        Ciphertext.CopyTo(input, 3);
+        Assert.Equal(Enumerable.Range(16, 32).Select(i => (byte)i).ToArray(),
+            SuperPeopleAes.Decrypt(input, 19, 32, Key));
+    }
+
+    [Fact]
+    public void RejectsPartialBlockAndOutOfBoundsRange()
+    {
+        Assert.Throws<ArgumentException>(() => SuperPeopleAes.Decrypt(Ciphertext, 0, 15, Key));
+        Assert.Throws<ArgumentException>(() => SuperPeopleAes.Decrypt(Ciphertext, 65, 0, Key));
+        Assert.Throws<ArgumentOutOfRangeException>(() => SuperPeopleAes.Decrypt(Ciphertext, -1, 16, Key));
+        Assert.Empty(SuperPeopleAes.Decrypt(Ciphertext, 64, 0, Key));
+    }
+
+    [Fact]
+    public void GameVersionSelectsCustomEncryption()
+    {
+        using var provider = new DefaultFileProvider(".", SearchOption.TopDirectoryOnly,
+            new VersionContainer(EGame.GAME_SuperPeople));
+        Assert.NotNull(provider.CustomEncryption);
+    }
+
+    [Fact]
+    public void MountsEncryptedVersion11IndexAndExtractsEncryptedPayload()
+    {
+        // Entirely synthetic archive using the build's standard v11 pak layout.
+        var bytes = Convert.FromBase64String("");
+        using var reader = new PakFileReader(new FByteArchive("synthetic.pak", bytes,
+            new VersionContainer(EGame.GAME_SuperPeople)));
+        reader.AesKey = Key;
+        reader.CustomEncryption = SuperPeopleAes.Decrypt;
+        Assert.True(reader.TestAesKey(Key));
+        reader.Mount(StringComparer.OrdinalIgnoreCase);
+        var file = Assert.Single(reader.Files).Value;
+        Assert.Equal("Example/Content/fixture.txt", file.Path);
+        Assert.Equal("Synthetic asset!"u8.ToArray(), file.Read());
+    }
+}
